# TypeSafe API key. Get one at https://typesafe.ai
# Server-side only. Never prefix with NEXT_PUBLIC_.
TYPESAFE_API_KEY=

# Optional: override the model. Defaults to jev-latest.
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional: local SQLite file. Defaults to ./data/jevscope.db
# DATABASE_URL=./data/jevscope.db
